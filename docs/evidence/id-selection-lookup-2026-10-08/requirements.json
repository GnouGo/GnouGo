      "id": "search_amazon_fr",
      "description": "Rechercher sur Amazon.fr l’article fourni par l’entrée query."
    },
    {
      "id": "collect_products",
      "description": "Lister et conserver les identifiants/original indexes des 10 premiers produits au maximum, sans renumérotation."
    },
    {
      "id": "visit_each_product",
      "description": "Naviguer sur la page de chaque produit sélectionné et extraire les observations disponibles."
    },
    {
      "id": "handle_absence_and_captcha",
      "description": "Indiquer explicitement les données absentes, les prix absents ou un blocage CAPTCHA, sans inventer de valeurs."
    },
    {
      "id": "save_excel",
      "description": "Créer et sauvegarder le fichier Excel products.xlsx au chemin imposé."
    },
    {
      "id": "cleanup_browser",
