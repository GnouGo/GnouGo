            "type": {
              "kind": "string"
            },
            "required": true
          },
          {
            "name": "products",
            "type": {
              "kind": "array",
              "items": {
                "kind": "object",
                "fields": [
                  {
                    "name": "name",
                    "type": {
                      "kind": "string",
                      "nullable": true
                    }
                  },
                  {
                    "name": "description",
                    "type": {
                      "kind": "string",
                      "nullable": true
                    }
                  },
                  {
                    "name": "price",
                    "type": {
                      "kind": "string",
                      "nullable": true
                    }
                  },
                  {
                    "name": "error",
