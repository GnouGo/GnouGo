          "query": "Navigate web browser to Amazon.fr, search query, list first search results, open product pages, extract visible text fields including product name/title, description, price, observed errors, and close browser even on failure",
          "operationIds": null
        },
        {
          "sourceId": "source_0002e1b8daaf46eef1b331cc",
          "cursor": null,
          "query": "Create and write Excel XLSX workbook to disk at a specified path with rows and columns for product name, description, price, observed errors/status",
          "operationIds": null
        }
      ],
      "plan": null,
      "clarifications": null,
      "requirements": {
        "summary": "Accept one public input named query, use Amazon.fr to search for that article, process at most the first 10 products, visit each product page, extract name, description, price, and explicit observed missing data/errors, save the results to an Excel workbook at workflows/schema-portability-20261002/typedcomposition20261011a-amazon-1/products.xlsx, and close the browser even if the workflow fails. Do not invent absent data and do not report success unless the work completed.",
        "outcomes": [
          {
            "id": "search_amazon_fr",
            "description": "Amazon.fr is searched using the provided query input."
          },
          {
            "id": "collect_products",
            "description": "Up to the first 10 listed products are collected for product-page navigation."
          },
          {
            "id": "extract_product_data",
            "description": "For each product page, extract product name, description, and price; if any value is absent or an error is observed, record it explicitly instead of inventing data."
          },
          {
            "id": "save_excel",
            "description": "Create an Excel workbook at workflows/schema-portability-20261002/typedcomposition20261011a-amazon-1/products.xlsx containing the extracted product rows."
          },
          {
            "id": "cleanup_browser",
            "description": "Close the browser even when search, extraction, or saving fails."
          },
          {
            "id": "truthful_completion",
            "description": "Do not declare success if the workflow did not complete successfully."
          }
        ],
        "inputs": [
          {
            "name": "query",
            "type": {
              "kind": "string"
            }
          }
        ],
        "outputs": [
