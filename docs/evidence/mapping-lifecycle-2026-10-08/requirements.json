{
  "summary": "Créer un workflow qui accepte une entrée publique `query`, recherche cette requête sur Amazon.fr, prend au maximum les 10 premiers produits, visite chaque page produit, extrait le nom, la description et le prix en gardant explicitement les absences ou CAPTCHA sans inventer de données, puis sauvegarde les résultats dans un fichier Excel local et ferme le navigateur même en cas d’échec.",
  "outcomes": [
    {
      "id": "search_amazon_fr",
      "description": "Utiliser Amazon.fr pour rechercher l’article fourni par l’entrée `query`."
    },
    {
      "id": "limit_products",
      "description": "Traiter au maximum les 10 premiers produits trouvés, sans échantillonnage global ni renumérotation des identifiants originaux observés."
    },
    {
      "id": "visit_each_product",
      "description": "Naviguer sur la page de chaque produit sélectionné et extraire les données visibles disponibles."
    },
    {
      "id": "explicit_missing_data",
      "description": "Si CAPTCHA, prix, description, nom ou autre donnée attendue est absent, l’indiquer explicitement sans inventer de valeur."
    },
    {
      "id": "save_excel",
      "description": "Sauvegarder le classeur Excel sur le disque à `workflows/schema-portability-20261002/mappinglifecycle20261008a-amazon-1/products.xlsx`."
    },
    {
      "id": "close_browser",
      "description": "Fermer le navigateur même en cas d’échec."
    }
  ],
