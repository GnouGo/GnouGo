<Project>
  <!-- EF's Roslyn project loader needs reflection for its own JSON protocol.
       Use the existing framework-dependent design build for trimmed consumers. -->
  <PropertyGroup Condition="'$(_EFGenerationStage)' == 'publish' and '$(PublishAot)' == 'false'">
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' == ''">false</PublishSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <Target Name="GnOuGoPrepareEfDesignHost" BeforeTargets="_EFGenerateFiles"
          Condition="'$(_EFGenerationStage)' == 'publish' and '$(PublishTrimmed)' == 'true' and '$(GnOuGoEfNeedsDesignHost)' == 'true'">
    <PropertyGroup>
      <_EFPublishAot>true</_EFPublishAot>
    </PropertyGroup>
  </Target>

  <!-- EF 11 emits nullable reference annotations in generated query interceptors
       without the annotation context required by the C# compiler for generated files. -->
  <UsingTask TaskName="GnOuGoEnableQueryAnnotations" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        foreach (var source in Sources)
        {
            var path = source.GetMetadata("FullPath");
            if (!Path.GetFileName(path).Contains(".EFInterceptors.") || !File.Exists(path)) continue;
            var text = File.ReadAllText(path);
            if (!text.StartsWith("// <auto-generated", StringComparison.Ordinal) ||
                text.Contains("#nullable") || !text.Contains("?")) continue;
            var temp = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
            try
            {
                File.WriteAllText(temp, "#nullable enable annotations" + Environment.NewLine + text);
                File.Replace(temp, path, null);
            }
            finally { if (File.Exists(temp)) File.Delete(temp); }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GnOuGoPrepareEfQueryAnnotations" AfterTargets="_EFReadGeneratedFilesList" Condition="'@(_EFGeneratedFiles)' != ''">
    <GnOuGoEnableQueryAnnotations Sources="@(_EFGeneratedFiles)" />
  </Target>
</Project>
