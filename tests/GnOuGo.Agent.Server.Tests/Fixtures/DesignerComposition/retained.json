        "type": {
          "kind": "array",
          "nullable": false,
          "minItems": 1,
          "maxItems": 11,
          "items": {
            "kind": "array",
            "nullable": false,
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "kind": "string",
              "nullable": true,
