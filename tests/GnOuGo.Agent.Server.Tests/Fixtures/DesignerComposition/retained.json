      {
        "name": "article",
        "type": {
          "kind": "string",
          "nullable": false,
          "items": null,
          "fields": []
        },
        "required": true,
        "default": null
      }
    ],
    "outputs": [
      {
        "name": "filePath",
        "type": {
          "kind": "string",
          "nullable": false,
          "items": null,
          "fields": []
        },
        "required": false,
        "default": null
      },
