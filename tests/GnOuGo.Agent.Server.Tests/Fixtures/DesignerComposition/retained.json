{
  "requirements": {
    "summary": "Workflow autonome: accepte un article à rechercher, recherche cet article sur Amazon France, prend les 10 premiers articles observés, visite chaque page disponible, extrait nom, description et prix, puis sauvegarde un fichier Excel dans workflows/amazon-article-extraction et retourne le chemin produit par l’écriture.",
    "outcomes": [
      {
        "id": "xlsx_saved",
        "description": "Un fichier .xlsx est écrit sur disque avec les en-têtes Nom, Description, Prix, Statut et jusqu’à 10 lignes dans l’ordre observé."
      },
      {
        "id": "producer_assertions",
        "description": "Chaque étape dépendante vérifie le succès déclaré, la disponibilité et la complétude des observations nécessaires."
      },
      {
        "id": "path_returned",
        "description": "Le workflow retourne le chemin du fichier tel que déclaré par document_write."
      }
    ],
