{
  "inputs": [
    {
      "name": "query",
      "type": {
        "kind": "string",
        "nullable": false
      },
      "required": true
    }
  ],
  "root": {
    "tasks": [
      {
        "id": "build_search_url",
        "objective": "Perform the declared transform business work with observed values.",
        "kind": "transform",
        "mode": "interpret",
        "inputs": [
          {
            "name": "query",
            "value": {
              "kind": "input",
              "source": "query"
            }
          }
        ],
        "resultType": {
          "kind": "object",
          "nullable": false,
          "fields": [
            {
              "name": "searchUrl",
              "type": {
                "kind": "string",
                "nullable": false
              },
              "required": true
            }
          ]
        },
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      },
      {
        "id": "open_search",
        "objective": "Perform the declared operation business work with observed values.",
        "kind": "operation",
        "dependsOn": [
          "build_search_url"
        ],
        "operation": "acquire",
        "inputs": [
          {
            "name": "url",
            "value": {
              "kind": "field",
              "port": "searchUrl",
              "items": [
                {
                  "kind": "output",
                  "source": "build_search_url"
                }
              ]
            }
          },
          {
            "name": "format",
            "value": {
              "kind": "string",
              "text": "observation_complete"
            }
          },
          {
            "name": "waitUntil",
            "value": {
              "kind": "string",
              "text": "domcontentloaded"
            }
          },
          {
            "name": "maxRecords",
            "value": {
              "kind": "number",
              "number": 200
            }
          },
          {
            "name": "timeoutMs",
            "value": {
              "kind": "number",
              "number": 45000
            }
          }
        ],
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      },
      {
        "id": "extract_search_candidates_by_page",
        "objective": "Perform the declared transform business work with observed values.",
        "kind": "transform",
        "mode": "extract",
        "each": {
          "input": "pages",
          "output": "candidateArrays"
        },
        "dependsOn": [
          "open_search"
        ],
        "inputs": [
          {
            "name": "pages",
            "value": {
              "kind": "field",
              "port": "pages",
              "items": [
                {
                  "kind": "field",
                  "port": "observationSnapshot",
                  "items": [
                    {
                      "kind": "output",
                      "source": "open_search"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "resultType": {
          "kind": "object",
          "nullable": false,
          "fields": [
            {
              "name": "candidateArrays",
              "type": {
                "kind": "array",
                "nullable": false,
                "minItems": 0,
                "maxItems": 100,
                "items": {
                  "kind": "array",
                  "nullable": false,
                  "minItems": 0,
                  "maxItems": 200,
                  "items": {
                    "kind": "object",
                    "nullable": false,
                    "fields": [
                      {
                        "name": "key",
                        "type": {
                          "kind": "string",
                          "nullable": false
                        },
                        "required": true
                      },
                      {
                        "name": "label",
                        "type": {
                          "kind": "string",
                          "nullable": true
                        },
                        "required": true
                      }
                    ]
                  }
                }
              },
              "required": true
            }
          ]
        },
        "requires": {
          "kind": "predicate",
          "items": [
            {
              "kind": "predicate",
              "items": [
                {
                  "kind": "field",
                  "port": "success",
                  "items": [
                    {
                      "kind": "output",
                      "source": "open_search"
                    }
                  ]
                },
                {
                  "kind": "boolean",
                  "boolean": true
                }
              ],
              "predicate": "equal"
            },
            {
              "kind": "predicate",
              "items": [
                {
                  "kind": "field",
                  "port": "observationSnapshot",
                  "items": [
                    {
                      "kind": "output",
                      "source": "open_search"
                    }
                  ]
                },
                {
                  "kind": "null"
                }
              ],
              "predicate": "not_equal"
            }
          ],
          "predicate": "and"
        },
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      },
      {
        "id": "project_search_original_records_by_page",
        "objective": "Perform the declared foreach business work with observed values.",
        "kind": "foreach",
        "dependsOn": [
          "open_search"
        ],
        "requires": {
          "kind": "predicate",
          "items": [
            {
              "kind": "predicate",
              "items": [
                {
                  "kind": "field",
                  "port": "success",
                  "items": [
                    {
                      "kind": "output",
                      "source": "open_search"
                    }
                  ]
                },
                {
                  "kind": "boolean",
                  "boolean": true
                }
              ],
              "predicate": "equal"
            },
            {
              "kind": "predicate",
              "items": [
                {
                  "kind": "field",
                  "port": "observationSnapshot",
                  "items": [
                    {
                      "kind": "output",
                      "source": "open_search"
                    }
                  ]
                },
                {
                  "kind": "null"
                }
              ],
              "predicate": "not_equal"
            }
          ],
          "predicate": "and"
        },
        "body": {
          "outputs": [
            {
              "name": "recordArrays",
              "value": {
                "kind": "field",
                "port": "records",
                "items": [
                  {
                    "kind": "item"
                  }
                ]
              }
            }
          ]
        },
        "items": {
          "kind": "field",
          "port": "pages",
          "items": [
            {
              "kind": "field",
              "port": "observationSnapshot",
              "items": [
                {
                  "kind": "output",
                  "source": "open_search"
                }
              ]
            }
          ]
        },
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 1
      },
      {
        "id": "select_candidate_ids",
        "objective": "Perform the declared transform business work with observed values.",
        "kind": "transform",
        "mode": "interpret",
        "dependsOn": [
          "extract_search_candidates_by_page"
        ],
        "inputs": [
          {
            "name": "offeredCandidates",
            "value": {
              "kind": "flatten",
              "items": [
                {
                  "kind": "output",
                  "source": "extract_search_candidates_by_page",
                  "port": "candidateArrays"
                }
              ]
            }
          }
        ],
        "resultType": {
          "kind": "object",
          "nullable": false,
          "fields": [
            {
              "name": "selectedIds",
              "type": {
                "kind": "array",
                "nullable": false,
                "minItems": 0,
                "maxItems": 10,
                "items": {
                  "kind": "string",
                  "nullable": false
                }
              },
              "required": true
            }
          ]
        },
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      },
      {
        "id": "resolve_selected_offers",
        "objective": "Perform the declared value business work with observed values.",
        "kind": "value",
        "dependsOn": [
          "extract_search_candidates_by_page",
          "select_candidate_ids"
        ],
        "outputs": [
          {
            "name": "selectedOffers",
            "value": {
              "kind": "lookup",
              "port": "key",
              "items": [
                {
                  "kind": "flatten",
                  "items": [
                    {
                      "kind": "output",
                      "source": "extract_search_candidates_by_page",
                      "port": "candidateArrays"
                    }
                  ]
                },
                {
                  "kind": "field",
                  "port": "selectedIds",
                  "items": [
                    {
                      "kind": "output",
                      "source": "select_candidate_ids"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      },
      {
        "id": "visit_products",
        "objective": "Perform the declared foreach business work with observed values.",
        "kind": "foreach",
        "dependsOn": [
          "resolve_selected_offers",
          "project_search_original_records_by_page",
          "select_candidate_ids"
        ],
        "body": {
          "tasks": [
            {
              "id": "open_product_page",
              "objective": "Perform the declared operation business work with observed values.",
              "kind": "operation",
              "operation": "acquire",
              "inputs": [
                {
                  "name": "url",
                  "value": {
                    "kind": "field",
                    "port": "href",
                    "items": [
                      {
                        "kind": "item"
                      }
                    ]
                  }
                },
                {
                  "name": "format",
                  "value": {
                    "kind": "string",
                    "text": "observation_complete"
                  }
                },
                {
                  "name": "waitUntil",
                  "value": {
                    "kind": "string",
                    "text": "domcontentloaded"
                  }
                },
                {
                  "name": "maxRecords",
                  "value": {
                    "kind": "number",
                    "number": 200
                  }
                },
                {
                  "name": "timeoutMs",
                  "value": {
                    "kind": "number",
                    "number": 45000
                  }
                }
              ],
              "requires": {
                "kind": "predicate",
                "items": [
                  {
                    "kind": "field",
                    "port": "href",
                    "items": [
                      {
                        "kind": "item"
                      }
                    ]
                  },
                  {
                    "kind": "null"
                  }
                ],
                "predicate": "not_equal"
              },
              "parallel": false,
              "maxItems": 100,
              "maxConcurrency": 4
            },
            {
              "id": "extract_product_facts_by_page",
              "objective": "Perform the declared transform business work with observed values.",
              "kind": "transform",
              "mode": "extract",
              "each": {
                "input": "pages",
                "output": "factArrays"
              },
              "dependsOn": [
                "open_product_page"
              ],
              "inputs": [
                {
                  "name": "pages",
                  "value": {
                    "kind": "field",
                    "port": "pages",
                    "items": [
                      {
                        "kind": "field",
                        "port": "observationSnapshot",
                        "items": [
                          {
                            "kind": "output",
                            "source": "open_product_page"
                          }
                        ]
                      }
                    ]
                  }
                }
              ],
              "resultType": {
                "kind": "object",
                "nullable": false,
                "fields": [
                  {
                    "name": "factArrays",
                    "type": {
                      "kind": "array",
                      "nullable": false,
                      "minItems": 0,
                      "maxItems": 100,
                      "items": {
                        "kind": "array",
                        "nullable": false,
                        "minItems": 0,
                        "maxItems": 20,
                        "items": {
                          "kind": "object",
                          "nullable": false,
                          "fields": [
                            {
                              "name": "name",
                              "type": {
                                "kind": "string",
                                "nullable": true
                              },
                              "required": true
                            },
                            {
                              "name": "description",
                              "type": {
                                "kind": "string",
                                "nullable": true
                              },
                              "required": true
                            },
                            {
                              "name": "price",
                              "type": {
                                "kind": "string",
                                "nullable": true
                              },
                              "required": true
                            },
                            {
                              "name": "error",
                              "type": {
                                "kind": "string",
                                "nullable": true
                              },
                              "required": true
                            }
                          ]
                        }
                      }
                    },
                    "required": true
                  }
                ]
              },
              "requires": {
                "kind": "predicate",
                "items": [
                  {
                    "kind": "predicate",
                    "items": [
                      {
                        "kind": "field",
                        "port": "success",
                        "items": [
                          {
                            "kind": "output",
                            "source": "open_product_page"
                          }
                        ]
                      },
                      {
                        "kind": "boolean",
                        "boolean": true
                      }
                    ],
                    "predicate": "equal"
                  },
                  {
                    "kind": "predicate",
                    "items": [
                      {
                        "kind": "field",
                        "port": "observationSnapshot",
                        "items": [
                          {
                            "kind": "output",
                            "source": "open_product_page"
                          }
                        ]
                      },
                      {
                        "kind": "null"
                      }
                    ],
                    "predicate": "not_equal"
                  }
                ],
                "predicate": "and"
              },
              "parallel": false,
              "maxItems": 100,
              "maxConcurrency": 4
            },
            {
              "id": "assemble_product_record",
              "objective": "Perform the declared transform business work with observed values.",
              "kind": "transform",
              "mode": "interpret",
              "dependsOn": [
                "extract_product_facts_by_page"
              ],
              "inputs": [
                {
                  "name": "compactFacts",
                  "value": {
                    "kind": "flatten",
                    "items": [
                      {
                        "kind": "output",
                        "source": "extract_product_facts_by_page",
                        "port": "factArrays"
                      }
                    ]
                  }
                }
              ],
              "resultType": {
                "kind": "object",
                "nullable": false,
                "fields": [
                  {
                    "name": "product",
                    "type": {
                      "kind": "object",
                      "nullable": false,
                      "fields": [
                        {
                          "name": "name",
                          "type": {
                            "kind": "string",
                            "nullable": true
                          },
                          "required": true
                        },
                        {
                          "name": "description",
                          "type": {
                            "kind": "string",
                            "nullable": true
                          },
                          "required": true
                        },
                        {
                          "name": "price",
                          "type": {
                            "kind": "string",
                            "nullable": true
                          },
                          "required": true
                        },
                        {
                          "name": "error",
                          "type": {
                            "kind": "string",
                            "nullable": true
                          },
                          "required": true
                        }
                      ]
                    },
                    "required": true
                  }
                ]
              },
              "parallel": false,
              "maxItems": 100,
              "maxConcurrency": 4
            }
          ],
          "outputs": [
            {
              "name": "product",
              "value": {
                "kind": "field",
                "port": "product",
                "items": [
                  {
                    "kind": "output",
                    "source": "assemble_product_record"
                  }
                ]
              }
            }
          ]
        },
        "items": {
          "kind": "lookup",
          "port": "reference",
          "items": [
            {
              "kind": "flatten",
              "items": [
                {
                  "kind": "output",
                  "source": "project_search_original_records_by_page",
                  "port": "recordArrays"
                }
              ]
            },
            {
              "kind": "field",
              "port": "selectedIds",
              "items": [
                {
                  "kind": "output",
                  "source": "select_candidate_ids"
                }
              ]
            }
          ]
        },
        "parallel": false,
        "maxItems": 10,
        "maxConcurrency": 1
      },
      {
        "id": "assemble_workbook_tsv",
        "objective": "Perform the declared transform business work with observed values.",
        "kind": "transform",
        "mode": "interpret",
        "dependsOn": [
          "visit_products"
        ],
        "inputs": [
          {
            "name": "products",
            "value": {
              "kind": "output",
              "source": "visit_products",
              "port": "product"
            }
          }
        ],
        "resultType": {
          "kind": "object",
          "nullable": false,
          "fields": [
            {
              "name": "content",
              "type": {
                "kind": "string",
                "nullable": false
              },
              "required": true
            }
          ]
        },
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      },
      {
        "id": "save_workbook",
        "objective": "Perform the declared operation business work with observed values.",
        "kind": "operation",
        "dependsOn": [
          "assemble_workbook_tsv"
        ],
        "operation": "persist",
        "inputs": [
          {
            "name": "filePath",
            "value": {
              "kind": "string",
              "text": "workflows/retained/items.xlsx"
            }
          },
          {
            "name": "content",
            "value": {
              "kind": "field",
              "port": "content",
              "items": [
                {
                  "kind": "output",
                  "source": "assemble_workbook_tsv"
                }
              ]
            }
          },
          {
            "name": "append",
            "value": {
              "kind": "boolean",
              "boolean": false
            }
          },
          {
            "name": "encoding",
            "value": {
              "kind": "string",
              "text": "utf-8"
            }
          }
        ],
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      },
      {
        "id": "validate_public_outputs",
        "objective": "Perform the declared value business work with observed values.",
        "kind": "value",
        "dependsOn": [
          "save_workbook",
          "visit_products"
        ],
        "outputs": [
          {
            "name": "filePath",
            "value": {
              "kind": "output",
              "source": "save_workbook",
              "port": "filePath"
            }
          },
          {
            "name": "products",
            "value": {
              "kind": "output",
              "source": "visit_products",
              "port": "product"
            }
          }
        ],
        "requires": {
          "kind": "predicate",
          "items": [
            {
              "kind": "field",
              "port": "success",
              "items": [
                {
                  "kind": "output",
                  "source": "save_workbook"
                }
              ]
            },
            {
              "kind": "boolean",
              "boolean": true
            }
          ],
          "predicate": "equal"
        },
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      }
    ],
    "outputs": [
      {
        "name": "filePath",
        "value": {
          "kind": "output",
          "source": "validate_public_outputs",
          "port": "filePath"
        }
      },
      {
        "name": "products",
        "value": {
          "kind": "output",
          "source": "validate_public_outputs",
          "port": "products"
        }
      }
    ],
    "always": [
      {
        "id": "close_browser",
        "objective": "Perform the declared operation business work with observed values.",
        "kind": "operation",
        "operation": "release",
        "parallel": false,
        "maxItems": 100,
        "maxConcurrency": 4
      }
    ]
  }
}
