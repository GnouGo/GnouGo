<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Matches Flow.Cli's existing Jint 4.16.0 publish boundary. The audit reports
       only Jint CLR interop warnings; Flow disables CLR access and performs its
       own JsonNode conversion. No library analyzers are disabled. See README.md. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(AuditKnownTrimWarnings)' != 'true'">
    <NoWarn>$(NoWarn);IL2026;IL2104;IL3053</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/GnOuGo.Flow.Planning/GnOuGo.Flow.Planning.csproj" /></ItemGroup>
</Project>
