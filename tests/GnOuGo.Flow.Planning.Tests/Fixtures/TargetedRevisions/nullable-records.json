      { "id": "release", "description": "Release the resource after processing." }
    ],
    "inputs": [{ "name": "observed", "type": {
      "kind": "array", "minItems": 0, "maxItems": 10,
      "items": { "kind": "object", "fields": [
        { "name": "identity", "type": { "kind": "integer" } },
        { "name": "label", "type": { "kind": "string", "nullable": true } },
        { "name": "detail", "type": { "kind": "string", "nullable": true } }
      ] }
    } }],
    "outputs": [{ "name": "rows", "type": {
      "kind": "array", "minItems": 0, "maxItems": 10,
      "items": { "kind": "object", "fields": [
        { "name": "identity", "type": { "kind": "integer" } },
        { "name": "label", "type": { "kind": "string", "nullable": true } },
        { "name": "detail", "type": { "kind": "string", "nullable": true } }
      ] }
    } }]
  },
  "plan": {
    "inputs": [{ "name": "observed", "type": {
      "kind": "array", "minItems": 0, "maxItems": 10,
      "items": { "kind": "object", "fields": [
        { "name": "identity", "type": { "kind": "integer" } },
        { "name": "label", "type": { "kind": "string", "nullable": true } },
        { "name": "detail", "type": { "kind": "string", "nullable": true } }
      ] }
    } }],
    "root": {
      "tasks": [{
        "id": "normalize", "kind": "transform", "mode": "interpret",
