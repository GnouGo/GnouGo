<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  </PropertyGroup>

  <!-- Jint's package-level Native AOT summaries and four internal IL2026
       diagnostics are audited by exact origin in
       scripts/verify-warning-free-publishes.ps1. The EF Core 11.0.0 SQLite closure also emits package summaries and two IL3002 origins (unused Spatialite discovery and DependencyContext). The exact-origin audit and published encrypted journal smoke cover this publish-only exception. Source analyzers remain enabled. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(AuditKnownTrimWarnings)' != 'true'">
    <NoWarn>$(NoWarn);IL2026;IL2104;IL3053;IL3002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GnOuGo.Flow.Copilot/GnOuGo.Flow.Copilot.csproj" />
    <ProjectReference Include="../GnOuGo.Flow.Persistence/GnOuGo.Flow.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GnOuGo.Flow.Core\GnOuGo.Flow.Core.csproj" />
    <ProjectReference Include="..\GnOuGo.Flow.Integrations\GnOuGo.Flow.Integrations.csproj" />
    <ProjectReference Include="..\GnOuGo.AI.Core\GnOuGo.AI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="examples\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="examples" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GnOuGo.Flow.Planning/GnOuGo.Flow.Planning.csproj" />
  </ItemGroup>
  <Import Project="../../build/GnOuGo.DarwinNativeCrypto.targets" />
</Project>
