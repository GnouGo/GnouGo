<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>15.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>DocIngestor.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GnOuGo.DocIngestor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GnOuGo.Auth.Core\GnOuGo.Auth.Core.csproj" />
    <ProjectReference Include="..\GnOuGo.AI.Core\GnOuGo.AI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DOCX / PPTX / XLSX extraction -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- PDF text extraction -->
    <PackageReference Include="PdfPig" Version="0.1.16" />

    <!-- Token counting (optional but helpful for chunking policies) -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="3.0.0" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="11.0.0" />
      <!-- SQLite store (MIT) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.16.8" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />

    <!-- OpenTelemetry for GenAI instrumentation -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.21.0" />
  </ItemGroup>

  <!-- Keep the native ABI aligned with the managed SkiaSharp package above. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>

</Project>
