<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>GnOuGo.Flow.Planning</PackageId>
    <PackageReleaseNotes>Replace historical planning and proposition/window review protocols with format-11 incremental construction, coherent business-block review and mandatory global review before approval. Retain exact recovery, scoped typed repairs, original MCP contracts and deterministic JavaScript/YAML v15 lowering.</PackageReleaseNotes>
    <Authors>GnOuGo</Authors>
    <Description>Provider-neutral, resumable typed workflow planning and deterministic YAML generation.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GnOuGo.Flow.Planning.Tests" />
    <InternalsVisibleTo Include="GnOuGo.Flow.Integrations.Tests" />
    <InternalsVisibleTo Include="GnOuGo.Flow.Planning.Smoke" />
    <InternalsVisibleTo Include="GnOuGo.Agent.Planning.Benchmark" />
    <InternalsVisibleTo Include="GnOuGo.Agent.Server.Tests" />
    <InternalsVisibleTo Include="GnOuGo.Agent.Server" />
    <InternalsVisibleTo Include="GnOuGo.Flow.Integrations" />
    <ProjectReference Include="../GnOuGo.Flow.Core/GnOuGo.Flow.Core.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
