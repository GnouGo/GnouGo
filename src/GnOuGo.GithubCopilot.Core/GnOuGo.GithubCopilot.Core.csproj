<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15.0</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>GnOuGo.GithubCopilot.Core</PackageId>
    <Authors>GnOuGo</Authors>
    <Company>GnOuGo</Company>
    <Description>Stable GitHub Copilot SDK session and pull-request review contracts for GnOuGo.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/GnouGo/GnouGo/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GnouGo/GnouGo/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gnougo;github;copilot;mcp;code-review</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
    <CopilotCliVersion>1.0.112</CopilotCliVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GnOuGo.GithubCopilot.Core.Tests" />
    <InternalsVisibleTo Include="GnOuGo.GithubCopilot.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.34" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Copilot's release archives give different versions the same 1985 mtime.
       Stamp the verified, project-local extraction once so incremental copies can
       distinguish even equal-sized wrappers when a consumer upgrades or downgrades. -->
  <Target Name="GnOuGoDateCopilotCache" AfterTargets="_DownloadCopilotCli"
          Condition="'$(CopilotCliBinaryPath)' == '' and Exists('$(_CopilotRuntimeBundleCompleteMarker)')"
          Inputs="$(_CopilotRuntimeBundleCompleteMarker)"
          Outputs="$(IntermediateOutputPath)gnougo-copilot-$(CopilotCliVersion)-$(_CopilotPlatform).stamp">
    <ItemGroup>
      <_GnOuGoCopilotCacheFile Include="$(_CopilotCacheDir)/**/*"
          Exclude="$(_CopilotRuntimeBundleCompleteMarker);$(_CopilotArchivePath);$(_CopilotChecksumPath)" />
    </ItemGroup>
    <Touch Files="@(_GnOuGoCopilotCacheFile)"
           Time="$([System.IO.File]::GetLastWriteTimeUtc('$(_CopilotRuntimeBundleCompleteMarker)').ToString('o'))" />
    <Touch Files="$(IntermediateOutputPath)gnougo-copilot-$(CopilotCliVersion)-$(_CopilotPlatform).stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="GnOuGoPropagateCopilotRuntime" AfterTargets="_RegisterCopilotCliForCopy"
          Condition="'$(CopilotCliBinaryPath)' == '' and Exists('$(_CopilotRuntimeBundleCompleteMarker)')">
    <ItemGroup>
      <ContentWithTargetPath Update="$(_CopilotCliBinaryPath);$(_CopilotRuntimeNodePath);@(_CopilotRuntimeRootAsset);@(_CopilotRuntimePrebuildAsset)"
          CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
