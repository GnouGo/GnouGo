@using GnOuGo.Agent.Server.Telemetry
@implements IDisposable
@inject IServiceProvider Services
<div class="trace-pipeline">
    <h3>Pipeline / LLM calls</h3>
    <p>One logical call per request. HTTP attempts are nested inside it. Response receipt, technical validation and business review are separate facts.</p>
    @if (SessionId is not null) { <p>Calls span all retained traces owned by this planning session. The trace selector controls raw spans and logs.</p> }
    <p><strong>@CallsView.Count calls</strong> · Known usage: @CallsView.Sum(c => c.InputTokens ?? 0) input / @CallsView.Sum(c => c.OutputTokens ?? 0) output tokens · @(CallsView.Any(c => c.InputTokens is null || c.OutputTokens is null) ? "incomplete coverage" : "complete coverage"). Reasoning tokens are included in output totals.</p>
    @if (_message is not null) { <p role="status">@_message</p> }
    @foreach (var group in CallsView.GroupBy(c => (c.BlockId, Phase: LlmInspectionLabels.Phase(c.Phase))))
    {
        <section class="trace-pipeline__phase">
            <h4>@(group.Key.BlockId ?? "Request-wide") · @group.Key.Phase</h4>
            @foreach (var call in group)
            {
                <article class="llm-call" data-request-id="@call.RequestId" @key="call.Identity">
                    <h5>@call.Provider / @call.Model</h5>
                    <p><code>@(call.RequestId ?? "Request ID unavailable")</code> · @call.Source</p>
                    <p>Response: @call.ResponseStatus<br />Technical validation: @call.TechnicalValidation<br />Business review: @call.BusinessReview</p>
                    <p>Input: @(call.InputTokens?.ToString() ?? "unknown") · Output: @(call.OutputTokens?.ToString() ?? "unknown")</p>
                    @if (call.Span is { } span)
                    {
                        <p>Observed span: @TraceDebugUiHelpers.FormatDuration(TraceDebugUiHelpers.GetSpanDurationMs(span)) · @(Value(span, "gnougo.llm.protocol") ?? "protocol unavailable")</p>
                        @if (call.JournalKey is null && Value(span, "gnougo.llm.estimated_cost") is { } estimate)
                        { <p>Span estimated cost: @estimate @Value(span, "gnougo.llm.cost_currency") · financial reservations unavailable in telemetry</p> }
                        @if (Value(span, "gnougo.llm.failure.kind") is { } failure)
                        { <p>Provider failure: @failure · HTTP @(Value(span, "gnougo.llm.failure.http_status") ?? "unknown") · retryable: @Value(span, "gnougo.llm.failure.retryable") · code: @(Value(span, "gnougo.llm.failure.provider_code") ?? "unavailable")</p> }
                    }
                    <LlmCallDetail Status="@call.ResponseStatus" Version="@(call.EvidenceVersion ?? (call.Span?.EndUtc.ToString("O") + ":" + call.Span?.Events.Count + ":" + call.ResponseStatus))" Reference="@(call.Span is { } s ? Value(s, "gnougo.llm.content_ref") : null)"
                        TraceId="@(call.TraceId ?? "")" SpanId="@(call.Span?.SpanId ?? "")" SessionId="@SessionId" WorkflowSession="WorkflowSession"
                        JournalKey="@call.JournalKey" InitiallyOpen="@(SelectedRequestId is not null && SelectedRequestId == call.RequestId)" />
                </article>
            }
        </section>
    }
    @if (CallsView.Count == 0) { <p>No retained model calls are available. Missing telemetry and historical evidence remain unavailable.</p> }
</div>
@code {
    [Parameter] public TraceGroupDto? Trace { get; set; }
    [Parameter] public IReadOnlyList<TraceGroupDto>? OwnedTraces { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public bool WorkflowSession { get; set; }
    [Parameter] public string? SelectedRequestId { get; set; }
    private readonly Dictionary<string, LlmCallProjection> _journal = new(StringComparer.Ordinal);
    private LlmCallCursor? _cursor;
    private string? _loadedSession, _message;
    private CancellationTokenSource? _load;
    private IReadOnlyList<LlmCallProjection> CallsView => LlmCallProjection.Join(_journal.Values,
        SessionId is not null && OwnedTraces is not null ? OwnedTraces : Trace is null ? [] : [Trace],
        Services.GetService<LlmTraceContentStore>()?.Tenant ?? Value(Trace?.Spans.FirstOrDefault() ?? EmptySpan, "tenant.id") ?? "",
        SessionId, WorkflowSession);
    private static readonly TraceSpanDto EmptySpan = new("", null, "", 0, default, default, 0, 0, null, new(), [], [], []);
    protected override async Task OnParametersSetAsync()
    {
        var key = SessionId + ":" + WorkflowSession;
        if (_loadedSession != key) { Dispose(); _loadedSession = key; _journal.Clear(); _cursor = null; }
        if (SessionId is null || Services.GetService<LlmTraceContentStore>() is not { } store) return;
        if (Services.GetService<GnOuGo.Agent.Server.Planning.LocalOperatorAccess>() is { } access && !await access.CanInspectAsync())
        { _message = "Local operator access is required to inspect planning journals."; return; }
        _load ??= new CancellationTokenSource(); var load = _load;
        try
        {
            var page = await store.ReadCallsAsync(SessionId, WorkflowSession, _cursor, load.Token, SelectedRequestId);
            if (_load != load || load.IsCancellationRequested) return;
            foreach (var call in page.Calls) _journal[call.Identity] = call;
            _cursor = page.Cursor; _message = page.HasMore ? "More retained calls will load on the next refresh." : null;
        }
        catch (OperationCanceledException) when (load.IsCancellationRequested) { }
        catch (Exception) { _message = "Journal summaries are currently unavailable; retained telemetry is still shown."; }
    }
    internal static string? Value(TraceSpanDto span, params string[] names) => TraceDebugUiHelpers.GetFirstAttribute(span.Attributes, names);
    internal static long? Number(TraceSpanDto span, params string[] names) => long.TryParse(Value(span, names), out var value) ? value : null;
    internal static string Phase(string? stage) => LlmInspectionLabels.Phase(stage);
    internal static List<TraceSpanDto> Calls(TraceGroupDto trace) => LlmCallProjection.Calls(trace);
    public void Dispose() { var load = _load; _load = null; load?.Cancel(); load?.Dispose(); }
}
