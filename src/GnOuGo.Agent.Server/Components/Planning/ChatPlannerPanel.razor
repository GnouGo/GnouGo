@using GnOuGo.Agent.Server.Planning
@using GnOuGo.Flow.Core.Planning
@inject IServiceProvider Services
@implements IAsyncDisposable
@if (_error is not null) { <p role="alert">@_error</p> }
@foreach (var session in _sessions)
{
    <article class="gnougo-chat__message gnougo-chat__message--assistant" @key="session.Id">
        <div class="gnougo-chat__bubble">
            <strong>Planning: @session.Name</strong>
            <p aria-live="polite">@session.Status.Replace('_', ' ') · @session.Phase</p>
            @if (session.PendingDecision is { } decision && session.Status == PlanningStatus.WaitingForDecision)
            {
                <PlannerDecisionCard Decision="decision" Busy="_busy" Answer="answer => Answer(session, answer)" Cancel="() => Cancel(session)" />
                <label>Planning mode<select value="@session.Mode" disabled="@_busy" @onchange='e => Submit(session, new() { Kind = "configure_mode", Mode = e.Value?.ToString() })'><option value="interactive">Interactive</option><option value="auto">Auto</option></select></label>
            }
            @if (session.Status == PlanningStatus.FinalReview)
            { <p>The workflow is ready for FinalReview. Planning decisions do not approve execution.</p> }
            <PlannerDecisionHistory Decisions="session.Decisions" />
            <a href="@($"/planning/{Uri.EscapeDataString(session.Id)}" + (session.WorkflowSession ? "?source=workflow" : ""))">Planning details</a>
        </div>
    </article>
}
@code {
    [Parameter] public string? ConversationId { get; set; }
    private IReadOnlyList<PlanningSessionDto> _sessions = [];
    private string? _conversation, _error;
    private bool _busy;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _poll;
    private ChatPlanningService? Service => Services.GetService<ChatPlanningService>();
    protected override async Task OnParametersSetAsync()
    {
        if (_conversation != ConversationId) { _conversation = ConversationId; _sessions = []; _error = null; }
        await Refresh(); _poll ??= Poll();
    }
    private async Task Refresh()
    {
        var conversation = ConversationId;
        if (Service is not { } service || string.IsNullOrWhiteSpace(conversation)) return;
        try { var sessions = await service.ListAsync(conversation, _lifetime.Token); if (conversation == ConversationId) _sessions = sessions; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = "Planning history could not be loaded. Retry shortly."; }
    }
    private async Task Poll()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(async () => { if (!_busy) await Refresh(); StateHasChanged(); }); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private Task Answer(PlanningSessionDto session, PlanningDecisionAnswerDto answer) => Submit(session, new() { Kind = "answer_decision", DecisionAnswer = new(answer.DecisionId, answer.OptionId, answer.Text) });
    private Task Cancel(PlanningSessionDto session) => Submit(session, new() { Kind = "cancel" });
    private async Task Submit(PlanningSessionDto session, PlanningCommand command)
    {
        if (Service is not { } service || ConversationId is null) return;
        _busy = true; _error = null; command.ExpectedRevision = session.Revision;
        try { await service.SubmitAsync(ConversationId, session.Id, command, _lifetime.Token); }
        catch (Exception ex) when (ex is ArgumentException or PlanningConflictException) { _error = ex.Message; }
        catch (Exception) { _error = "The answer could not be saved. Reload the current decision before retrying."; }
        finally { _busy = false; await Refresh(); }
    }
    public async ValueTask DisposeAsync() { await _lifetime.CancelAsync(); if (_poll is not null) await _poll; _lifetime.Dispose(); }
}
