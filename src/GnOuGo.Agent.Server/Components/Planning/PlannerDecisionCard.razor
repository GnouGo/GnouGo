<section class="planner-decision" aria-labelledby="@($"decision-{Decision.Id}")">
    <h3 id="@($"decision-{Decision.Id}")">@Decision.Question</h3>
    <p>@Decision.Context</p>
    <small>@Decision.Phase · @Decision.Scope</small>
    <fieldset disabled="@Busy">
        <legend>Choose an option</legend>
        @foreach (var option in Decision.Options)
        {
            <label class="planner-option @(option.Preferred ? "planner-option--preferred" : "")">
                <input type="radio" name="@Decision.Id" checked="@(_option == option.Id)" @onchange="() => Select(option.Id)" />
                <strong>@option.Label</strong>
                @if (option.Preferred) { <span class="planner-preferred">Preferred</span> }
                <span>@option.Reason</span>
            </label>
        }
        @if (Decision.AllowCustomAnswer)
        {
            <label for="@($"custom-{Decision.Id}")">Or give your own answer</label>
            <textarea id="@($"custom-{Decision.Id}")" rows="3" value="@_text" @oninput="Custom" placeholder="Describe your business preference"></textarea>
        }
        <div class="planner-actions">
            <button type="button" disabled="@(_option is null && string.IsNullOrWhiteSpace(_text))" @onclick="Submit">Submit answer</button>
            <button type="button" @onclick="Cancel">Cancel planning</button>
        </div>
    </fieldset>
</section>
@code {
    [Parameter, EditorRequired] public PlanningDecisionDto Decision { get; set; } = null!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<PlanningDecisionAnswerDto> Answer { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private string? _id, _option;
    private string _text = "";
    protected override void OnParametersSet()
    {
        if (_id == Decision.Id) return;
        _id = Decision.Id; _option = Decision.Options.SingleOrDefault(o => o.Preferred)?.Id; _text = "";
    }
    private void Select(string id) { _option = id; _text = ""; }
    private void Custom(ChangeEventArgs args) { _text = args.Value?.ToString() ?? ""; _option = null; }
    private Task Submit() => Answer.InvokeAsync(new(Decision.Id, _option, _option is null ? _text.Trim() : null));
}
