@using GnOuGo.Flow.Core.Planning
<p>Business review is required and shares this session's model allowance.</p>
@if (Session.ValidationResults.Any(r => r.Id.StartsWith("judge:", StringComparison.Ordinal)))
{
    <details open aria-label="Business judge observations"><summary>Business judge observations</summary>
        <p>Model observations are advisory. They do not prove correctness, authorize edits or replace your requirement review.</p>
        <ul>@foreach (var observation in Session.ValidationResults.Where(r => r.Id.StartsWith("judge:", StringComparison.Ordinal)))
        { <li><strong>@observation.Outcome</strong>: @observation.Description</li> }</ul>
    </details>
}
@if (Session.Status == PlanningStatus.Clarification)
{
    <p role="status">Waiting for a business decision. Submit your answers to continue planning within its remaining allowance.</p>
}
else if (Session.Status == PlanningStatus.Generating && Session.Diagnostics.Count > 0)
{
    <p role="status">Correcting the diagnosed plan within the remaining allowance. No workflow is executing.</p>
}
else if (Session.Status == PlanningStatus.Stopped && Session.Diagnostics.Any(d => d.Code is "LLM_BUDGET_EXCEEDED" or "CLARIFICATION_CONTINUATION_UNAVAILABLE"))
{
    <p role="status">Planning stopped because its allowance cannot support another continuation. Answers and retries do not reset that allowance.</p>
}
@if (Session.ValidationResults.Any(r => r.Id.StartsWith("input_readiness:", StringComparison.Ordinal)))
{
    <details open aria-label="LLM input readiness"><summary>LLM input readiness</summary>
        <p>Input fit remains unverified until the complete request is checked against the runtime model allowance. Output and iteration limits do not establish input fit.</p>
        <ul>@foreach (var observation in Session.ValidationResults.Where(r => r.Id.StartsWith("input_readiness:", StringComparison.Ordinal)))
        { <li><strong>Unverified</strong>: @observation.Description</li> }</ul>
    </details>
}
@if (Session.Requirements is { } requirements)
{
    @if (Session.RequestText is { } requestText)
    {
        <details open aria-label="Original request and revisions"><summary>Original request and revisions</summary><pre>@requestText</pre></details>
    }
    var accepted = System.Text.Json.JsonSerializer.Deserialize(requirements, PlanningJsonContext.Default.PlanningRequirements)!;
    <details open><summary id="business-requirements" tabindex="-1" @ref="_requirementsSummary">Business requirements</summary>
        <p>Each acknowledgment includes comparing the original request and revisions with these requirements and business tasks: check omitted actions, missing outputs, extra effects and cleanup. Compilation does not prove business completeness or execution success.</p>
        <p>Check each requested action inside its iteration and condition. Partial observations with continuation are incomplete.</p>
        @if (Session.ValidationResults.Any(r => r.Id.StartsWith("coverage:", StringComparison.Ordinal)))
        { <p>Confirmed violations block approval. Checking a requirement explicitly acknowledges its unverified aspects; they remain unverified after approval. Human review is not execution evidence.</p> }
        else
        { <p>Missing or uncertain coverage requires revision.</p> }
        <ul>@foreach (var outcome in accepted.Outcomes)
        {
            <li>@if (ReviewEnabled)
                {
                    <label><input type="checkbox" checked="@_reviewed.Contains(outcome.Id)" disabled="@(Busy || HasCoverageViolation)"
                        @onchange="e => ReviewAsync(outcome.Id, e.Value is true)" /> @outcome.Description</label>
                }
                else { @outcome.Description }
                @if (outcome.Commitments is { Count: > 0 } commitments)
                {
                    <ul aria-label="Contractual commitments">@foreach (var commitment in commitments)
                    {
                        <li>Operation <code>@commitment.Operation</code>
                            @if (commitment.Result is { } result)
                            { <span> — result <code>@result.Port</code> supplies public output <code>@result.Output</code></span> }
                        </li>
                    }</ul>
                }
                @if (Coverage(outcome.Id).Any())
                {
                    <ul aria-label="Coverage evidence">@foreach (var check in Coverage(outcome.Id))
                    {
                        <li><strong>@CoverageLabel(check.Outcome)</strong>: @check.Description
                        </li>
                    }</ul>
                }
            </li>
        }</ul>
        @if (accepted.Inputs is { } inputs)
        { <p>Caller inputs: @(inputs.Count == 0 ? "none" : string.Join(", ", inputs.Select(i => i.Name)))</p> }
        @if (accepted.Outputs is { } outputs)
        { <p>Business outputs: @(outputs.Count == 0 ? "none" : string.Join(", ", outputs.Select(o => o.Name + ": " + o.Type.Kind + (o.Type.Nullable ? " (nullable)" : ""))))</p> }
    </details>
}
@if (Session.Graph is { } graph)
{
    <PlannerAgentStages Graph="@(System.Text.Json.JsonSerializer.Deserialize(graph, PlanningJsonContext.Default.PlanningGraph)!)" />
}
@if (Session.ValidationResults.Any(r => r.Id.StartsWith("operation:", StringComparison.Ordinal)))
{
    <details><summary>Resolved operations</summary><ul>
        @foreach (var operation in Session.ValidationResults.Where(r => r.Id.StartsWith("operation:", StringComparison.Ordinal)))
        { <li>@operation.Description</li> }
    </ul></details>
}
@if (Session.RevisionScope.Count > 0)
{
    <p>Tasks open for revision: @string.Join(", ", Session.RevisionScope)</p>
}
@if (Session.DiscoveryLimitations.Count > 0)
{
    <details><summary>Discovery limitations</summary><ul>
        @foreach (var limitation in Session.DiscoveryLimitations) { <li>@limitation</li> }
    </ul></details>
}
@if (ShowFindings && Session.Diagnostics.Count > 0)
{
    <ul>@foreach (var finding in Session.Diagnostics)
    {
        <li><strong>@finding.Code</strong>: @finding.Message <small>@finding.Location</small>
            @if (finding.Prerequisite is { } prerequisite)
            {
                <p>@prerequisite.Description</p>
                @if (prerequisite.RootActionId is { } root) { <p>Blocked by action: <code>@root</code></p> }
                @if (prerequisite.ContractPath is { } path) { <p>Required consumer input: <code>@path</code></p> }
            }
        </li>
    }</ul>
}
@if (Session.TaskPlan is { } plan)
{
    var semantic = System.Text.Json.JsonSerializer.Deserialize(plan, PlanningJsonContext.Default.TaskPlan)!;
    <details open><summary>Business tasks</summary><PlannerTasks Scope="semantic.Root" Associations="Session.ValidationResults" />
        @foreach (var group in semantic.Groups) { <p>Reusable group: @group.Id</p><PlannerTasks Scope="group.Body" Associations="Session.ValidationResults" /> }
    </details>
}
@foreach (var choice in Session.Choices.Where(c => c.Selected is not null))
{
    <details><summary>@choice.Question</summary>
        <p>Recommended: @choice.Recommended · Selected: @choice.Selected</p>
        @foreach (var alternative in choice.Alternatives) { <p>@alternative.Id: @alternative.Description</p> }
    </details>
}
@code {
    [Parameter, EditorRequired] public PlanningSessionDto Session { get; set; } = default!;
    [Parameter] public bool ShowFindings { get; set; } = true;
    [Parameter] public bool ReviewEnabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<string>> Reviewed { get; set; }
    private bool HasCoverageViolation => Session.ValidationResults.Any(r => r.Id.StartsWith("coverage:", StringComparison.Ordinal) && r.Outcome == "violation");
    private IEnumerable<GnOuGo.Agent.Shared.PlanningValidationResultDto> Coverage(string id) => Session.ValidationResults.Where(r => r.Id.StartsWith("coverage:" + Uri.EscapeDataString(id) + ":", StringComparison.Ordinal));
    private static string CoverageLabel(string outcome) => outcome switch { "verified" => "Verified clause", "violation" => "Violation", _ => "Unverified" };
    private readonly HashSet<string> _reviewed = new(StringComparer.Ordinal);
    private ElementReference _requirementsSummary;
    public ValueTask FocusRequirementsAsync() => _requirementsSummary.FocusAsync();
    private (string, long, string?) _key;
    protected override void OnParametersSet()
    {
        var key = (Session.Id, Session.Revision, Session.ArtifactHash);
        if (_key != key) { _reviewed.Clear(); _key = key; }
    }
    private Task ReviewAsync(string id, bool selected)
    {
        if (Busy || !ReviewEnabled || HasCoverageViolation) return Task.CompletedTask;
        if (selected) _reviewed.Add(id); else _reviewed.Remove(id);
        return Reviewed.InvokeAsync(_reviewed.ToArray());
    }
}
