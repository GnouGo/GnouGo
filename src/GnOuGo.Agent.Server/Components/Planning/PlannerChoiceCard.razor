@using System.Text.Json.Nodes
<form @onsubmit="Submit" @onsubmit:preventDefault>
    @foreach (var question in Pending)
    {
        <div class="planner-question">
            <label for="@ControlId(question)">@question.Question</label>
            @if (question.Alternatives.Count > 0)
            {
                <select id="@ControlId(question)" class="form-control" disabled="@Busy" value="@Selection(question)" @onchange="e => _selections[question.Id] = e.Value?.ToString() ?? Custom">
                    @foreach (var alternative in question.Alternatives)
                    {
                        <option value="@alternative.Id">@alternative.Description @(alternative.Id == question.Recommended ? "(Recommended)" : "")</option>
                    }
                    <option value="@Custom">Different answer…</option>
                </select>
            }
            @if (Selection(question) == Custom)
            {
                @if (question.Alternatives.Count > 0) { <label for="@(ControlId(question) + "-text")">Your answer</label> }
                <textarea id="@(question.Alternatives.Count > 0 ? ControlId(question) + "-text" : ControlId(question))" class="form-control" rows="3" maxlength="8192" required disabled="@Busy"
                    value="@_text.GetValueOrDefault(question.Id, "")" @oninput="e => _text[question.Id] = e.Value?.ToString() ?? string.Empty"></textarea>
            }
        </div>
    }
    @if (_error is not null) { <p role="alert">@_error</p> }
    <button type="submit" disabled="@Busy">Confirm selections</button>
    <button type="button" disabled="@Busy" @onclick="Cancel">Cancel planning</button>
</form>
@code {
    [Parameter] public IReadOnlyList<PlanningChoiceDto> Choices { get; set; } = [];
    [Parameter] public IReadOnlyList<PlanningQuestionDto> Questions { get; set; } = [];
    [Parameter] public string DecisionKey { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<JsonObject> Select { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<PlanningAnswerDto>> Answer { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private readonly Dictionary<string, string> _selections = new();
    private readonly Dictionary<string, string> _text = new();
    private const string Custom = "";
    private readonly string _id = "planning-" + Guid.NewGuid().ToString("N");
    private string? _key, _error;
    private IReadOnlyList<PlanningQuestionDto> Pending => Questions.Count > 0 ? Questions : Choices.Where(c => c.Selected is null)
        .Select(c => new PlanningQuestionDto(c.Id, c.Question, c.Alternatives, c.Recommended)).ToArray();
    private string Selection(PlanningQuestionDto question) => _selections.GetValueOrDefault(question.Id, question.Recommended ?? Custom);
    private string ControlId(PlanningQuestionDto question) => _id + "-" + question.Id;
    protected override void OnParametersSet()
    {
        if (_key == DecisionKey) return;
        _key = DecisionKey; _selections.Clear(); _text.Clear(); _error = null;
    }
    private Task Submit()
    {
        if (Busy) return Task.CompletedTask;
        _error = null;
        if (Pending.Any(q => Selection(q) == Custom && string.IsNullOrWhiteSpace(_text.GetValueOrDefault(q.Id))))
        { _error = "Enter an answer for each question."; return Task.CompletedTask; }
        if (Questions.Count == 0 && Pending.All(q => Selection(q) != Custom))
            return Select.InvokeAsync(new JsonObject(Pending.Select(q => new KeyValuePair<string, JsonNode?>(q.Id, JsonValue.Create(Selection(q))))));
        return Answer.InvokeAsync(Pending.Select(q => Selection(q) == Custom
            ? new PlanningAnswerDto(q.Id, Text: _text[q.Id]) : new PlanningAnswerDto(q.Id, Selection(q))).ToArray());
    }
}
