@using System.Text.Json.Nodes
<form @onsubmit="Submit" @onsubmit:preventDefault>
    @foreach (var question in Questions)
    {
        <label for="@question.Id">@question.Question</label>
        <input id="@question.Id" class="form-control" disabled="@Busy" value="@_answers.GetValueOrDefault(question.Id)" @oninput="e => _answers[question.Id] = e.Value?.ToString() ?? string.Empty" />
        <small>Expected value: @question.AnswerSchema["type"]</small>
    }
    @if (_error is not null) { <p role="alert">@_error</p> }
    <button type="submit" disabled="@Busy">Submit answers</button>
    <button type="button" disabled="@Busy" @onclick="Cancel">Cancel planning</button>
</form>
@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlanningQuestionDto> Questions { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<JsonObject> Answer { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private readonly Dictionary<string, string> _answers = new();
    private string? _error;
    private async Task Submit()
    {
        var answers = new JsonObject(); _error = null;
        foreach (var question in Questions)
        {
            var text = _answers.GetValueOrDefault(question.Id) ?? "";
            if (question.AnswerSchema["type"]?.ToString() == "string") answers[question.Id] = text;
            else
            {
                try { answers[question.Id] = JsonNode.Parse(text); }
                catch (System.Text.Json.JsonException) { _error = "Enter a valid JSON value for: " + question.Question; return; }
            }
        }
        await Answer.InvokeAsync(answers);
    }
}
