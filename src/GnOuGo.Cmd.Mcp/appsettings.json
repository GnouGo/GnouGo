{
  "Cmd": {
    "DefaultWorkingDirectory": "GnOuGo",
    "DefaultTimeoutMs": 60000,
    "MaxTimeoutMs": 300000,
    "MaxOutputCharacters": 128000,
    "AllowedShells": [
      "sh",
      "bash",
      "zsh",
      "powershell",
      "cmd"
    ],
    "AllowedWorkingRoots": [],
    "EnvironmentAllowList": [
      "PATH",
      "PATHEXT",
      "ComSpec",
      "SystemRoot",
      "WINDIR",
      "TMP",
      "TEMP",
      "USERPROFILE",
      "HOME"
    ],
    "AllowedCommands": {
      "print_working_directory": {
        "Description": "Print the current working directory of the default writable workspace.",
        "Shell": "sh",
        "Script": "pwd",
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-Location | Select-Object -ExpandProperty Path"
          }
        }
      },
      "list_root": {
        "Description": "List top-level entries in the default writable workspace.",
        "Shell": "sh",
        "Script": "ls -1",
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-ChildItem -Name ."
          }
        }
      },
      "list_relative_path": {
        "Description": "List the contents of a relative path located inside the default writable workspace.",
        "Shell": "sh",
        "Script": "ls -1 {{path}}",
        "Parameters": {
          "path": {
            "Description": "Relative path to inspect inside the writable workspace.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-ChildItem -Name {{path}}"
          }
        }
      },
      "create_directory": {
        "Description": "Create a subdirectory inside the default writable workspace and return its resolved path.",
        "Shell": "sh",
        "Script": "mkdir -p {{path}} && cd {{path}} && pwd",
        "Parameters": {
          "path": {
            "Description": "Relative directory path to create inside the writable workspace.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "PathKind": "Directory"
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "$target = {{path}}; New-Item -ItemType Directory -Path $target -Force | Out-Null; Resolve-Path $target | Select-Object -ExpandProperty Path"
          }
        }
      },
      "delete_directory": {
        "Description": "Ensure a workspace directory is absent. Recursively deletes an existing directory; an already-absent path succeeds. A file target or deletion failure is an error. Explicit configured path preconditions still apply.",
        "Shell": "sh",
        "Script": "target={{path}}\nif [ -L \"$target\" ]; then printf '%s\\n' 'Directory links are not supported.' >&2; exit 1; fi\nif [ -e \"$target\" ]; then\n  [ -d \"$target\" ] || { printf '%s\\n' 'Target must be a directory.' >&2; exit 1; }\n  rm -rf -- \"$target\" || exit 1\nfi\n[ ! -e \"$target\" ] && [ ! -L \"$target\" ] || { printf '%s\\n' 'Directory is still present.' >&2; exit 1; }\nprintf 'absent: %s\\n' \"$target\"",
        "Parameters": {
          "path": {
            "Description": "Relative directory path to remove; it may already be absent.",
            "Required": true,
            "Pattern": "^(?![\\\\/])(?!\\.{1,2}$)(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[A-Za-z0-9_.\\\\/-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "MustExist": false,
            "PathKind": "Directory"
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "$ErrorActionPreference = 'Stop'; $target = {{path}}; if (Test-Path -LiteralPath $target -ErrorAction Stop) { $item = Get-Item -LiteralPath $target -Force -ErrorAction Stop; if (-not $item.PSIsContainer -or ($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint)) { throw 'Target must be a directory, not a file or link.' }; Remove-Item -LiteralPath $target -Recurse -Force -ErrorAction Stop }; if (Test-Path -LiteralPath $target -ErrorAction Stop) { throw 'Directory is still present.' }; Write-Output \"absent: $target\""
          }
        }
      },
      "cat_file": {
        "Description": "Print the contents of a file inside the default writable workspace.",
        "Shell": "sh",
        "Script": "cat {{path}}",
        "Parameters": {
          "path": {
            "Description": "Relative file path to read inside the writable workspace.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "PathKind": "File"
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-Content -Raw {{path}}"
          }
        }
      },
      "grep_recursive": {
        "Description": "Search for a text pattern recursively in the default writable workspace.",
        "Shell": "sh",
        "Script": "grep -rn --exclude-dir='.GnOuGo' --include='{{glob}}' '{{pattern}}' . | head -200",
        "Parameters": {
          "pattern": {
            "Description": "Text or regex pattern to search for.",
            "Required": true,
            "MaxLength": 500
          },
          "glob": {
            "Description": "File glob pattern to filter (e.g. *.cs, *.json).",
            "Required": false,
            "MaxLength": 100
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-ChildItem -Recurse -Filter '{{glob}}' | Where-Object { $_.FullName -notmatch '([\\/])\\.GnOuGo([\\/]|$)' } | Select-String -Pattern '{{pattern}}' | Select-Object -First 200"
          }
        }
      },
      "find_files": {
        "Description": "Find files by name pattern in the default writable workspace.",
        "Shell": "sh",
        "Script": "find . -path './.GnOuGo' -prune -o -type f -name '{{pattern}}' -print | head -200",
        "Parameters": {
          "pattern": {
            "Description": "File name pattern (e.g. *.cs, *.csproj).",
            "Required": true,
            "MaxLength": 200
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-ChildItem -Recurse -Filter '{{pattern}}' | Where-Object { $_.FullName -notmatch '([\\/])\\.GnOuGo([\\/]|$)' } | Select-Object -First 200 -ExpandProperty FullName"
          }
        }
      },
      "tree": {
        "Description": "Display the directory tree structure of a relative path in the writable workspace.",
        "Shell": "sh",
        "Script": "find {{path}} -maxdepth {{depth}} -path '*/.GnOuGo' -prune -o -print | head -300 | sort",
        "Parameters": {
          "path": {
            "Description": "Relative path to inspect.",
            "Required": false,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{0,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true
          },
          "depth": {
            "Description": "Max directory depth (default 3).",
            "Required": false,
            "Pattern": "^[0-9]{1,2}$",
            "MaxLength": 2
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-ChildItem -Recurse -Depth {{depth}} {{path}} | Where-Object { $_.FullName -notmatch '([\\/])\\.GnOuGo([\\/]|$)' } | Select-Object -First 300 -ExpandProperty FullName | Sort-Object"
          }
        }
      },
      "write_file": {
        "Description": "Create or overwrite any text file inside the default writable workspace. The content must be provided as UTF-8 base64.",
        "Shell": "sh",
        "Script": "mkdir -p \"$(dirname {{path}})\" && printf '%s' {{contentBase64}} | base64 -d > {{path}} && echo {{path}}",
        "Parameters": {
          "path": {
            "Description": "Relative file path to create inside the writable workspace.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "PathKind": "File"
          },
          "contentBase64": {
            "Description": "File content encoded as UTF-8 base64.",
            "Required": true,
            "MaxLength": 65536,
            "Pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "OsOverrides": {
          "macos": {
            "Script": "mkdir -p \"$(dirname {{path}})\" && printf '%s' {{contentBase64}} | base64 -D > {{path}} && echo {{path}}"
          },
          "windows": {
            "Shell": "powershell",
            "Script": "$target = {{path}}; $parent = Split-Path -Parent $target; if ($parent) { New-Item -ItemType Directory -Path $parent -Force | Out-Null }; $content = [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String({{contentBase64}})); [System.IO.File]::WriteAllText($target, $content, [System.Text.UTF8Encoding]::new($false)); Write-Output $target"
          }
        }
      },
      "delete_file": {
        "Description": "Delete a file inside the default writable workspace.",
        "Shell": "sh",
        "Script": "test -f {{path}} && rm -f -- {{path}} && printf '%s\n' {{path}}",
        "Parameters": {
          "path": {
            "Description": "Relative file path to delete inside the writable workspace.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "MustExist": false,
            "PathKind": "File"
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "$target = {{path}}; if (-not (Test-Path -LiteralPath $target -PathType Leaf)) { throw \"File not found: $target\" }; Remove-Item -LiteralPath $target -Force; Write-Output $target"
          }
        }
      },
      "head_file": {
        "Description": "Print the first N lines of a file in the writable workspace.",
        "Shell": "sh",
        "Script": "head -n {{lines}} {{path}}",
        "Parameters": {
          "path": {
            "Description": "Relative file path to read.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "PathKind": "File"
          },
          "lines": {
            "Description": "Number of lines to print (default 50).",
            "Required": false,
            "Pattern": "^[0-9]{1,5}$",
            "MaxLength": 5
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-Content {{path}} -TotalCount {{lines}}"
          }
        }
      },
      "tail_file": {
        "Description": "Print the last N lines of a file in the writable workspace.",
        "Shell": "sh",
        "Script": "tail -n {{lines}} {{path}}",
        "Parameters": {
          "path": {
            "Description": "Relative file path to read.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "PathKind": "File"
          },
          "lines": {
            "Description": "Number of lines to print (default 50).",
            "Required": false,
            "Pattern": "^[0-9]{1,5}$",
            "MaxLength": 5
          }
        },
        "OsOverrides": {
          "windows": {
            "Shell": "powershell",
            "Script": "Get-Content {{path}} -Tail {{lines}}"
          }
        }
      },
      "wc": {
        "Description": "Count lines, words, and characters of a file in the writable workspace.",
        "Shell": "sh",
        "Script": "wc {{path}}",
        "Parameters": {
          "path": {
            "Description": "Relative file path.",
            "Required": true,
            "Pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./\\-]{1,240}$",
            "MaxLength": 240,
            "IsWorkspacePath": true,
            "PathKind": "File"
          }
        }
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "GnOuGo.Cmd.Mcp",
    "OtlpEndpoint": "http://127.0.0.1:4317",
    "Protocol": "Grpc",
    "IncludeLogs": true,
    "IncludeMetrics": true,
    "IncludeHttpClientInstrumentation": true,
    "IncludeAspNetCoreTraces": false
  }
}
