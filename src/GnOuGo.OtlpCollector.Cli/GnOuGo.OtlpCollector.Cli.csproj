<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OtlpTestCli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenTelemetry .NET SDK officiel -->
    <PackageReference Include="OpenTelemetry" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    
    <!-- Command Line Interface -->
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    
    <!-- Pour la configuration et DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
  </ItemGroup>
</Project>
